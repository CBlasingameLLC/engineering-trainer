{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@et/domain": ["packages/domain/src/index.ts"],
      "@et/domain/*": ["packages/domain/src/*"],
      "@et/content-schema": ["packages/content-schema/src/index.ts"],
      "@et/answer-engine": ["packages/answer-engine/src/index.ts"],
      "@et/generators": ["packages/generators/src/index.ts"],
      "@et/circuits": ["packages/circuits/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "packages/*/test/**/*", "tools/*/src/**/*"],
  "exclude": ["node_modules", "**/dist", "apps/desktop"]
}
