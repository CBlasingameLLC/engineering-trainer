{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions the renderer needs: window controls, and full read/write access to the local learner database.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "sql:allow-close",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen"
  ]
}
